@page "/cursos"
    @rendermode InteractiveServer
@using LP3.Shared.DTOs
@using LP3.BlazorServer.Application.Services

@inject ICursoService CursoService

<div class="container mt-5">
    <div class="card mb-4">
        <div class="card-body">
            <h4>🔍 Buscar Curso por Código</h4>
            <div class="input-group">
                <input type="text"
                       class="form-control"
                       @bind="codigoBusqueda"
                       placeholder="Ej: IRI-005" />
                <button class="btn btn-primary" @onclick="BuscarPorCodigo">
                    Buscar
                </button>
            </div>

            @if (!string.IsNullOrEmpty(mensajeBusqueda))
            {
                <div class="alert alert-info mt-3">
                    @mensajeBusqueda
                </div>
            }

            @if (cursoBuscado != null)
            {
                <div class="alert alert-success mt-3">
                    <strong>✓ Encontrado:</strong>
                    @cursoBuscado.Nombre (@cursoBuscado.Codigo) - Créditos: @cursoBuscado.Creditos
                </div>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h4>➕ Crear Nuevo Curso</h4>
            <EditForm Model="nuevoCurso" OnValidSubmit="RegistrarCurso">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="nombre" class="form-label">Nombre:</label>
                        <InputText id="nombre" class="form-control" @bind-Value="nuevoCurso.Nombre" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="codigo" class="form-label">Código:</label>
                        <InputText id="codigo" class="form-control" @bind-Value="nuevoCurso.Codigo" />
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="creditos" class="form-label">Créditos:</label>
                        <InputNumber id="creditos" class="form-control" @bind-Value="nuevoCurso.Creditos" />
                    </div>
                    <div class="col-md-6 mb-3 form-check mt-4">
                        <InputCheckbox id="activo" class="form-check-input" @bind-Value="nuevoCurso.Activo" />
                        <label class="form-check-label" for="activo">Activo</label>
                    </div>
                </div>

                <button type="submit" class="btn btn-success">Guardar Curso</button>
            </EditForm>

            @if (!string.IsNullOrEmpty(mensajeGeneral))
            {
                <div class="alert mt-3" style="@(mensajeGeneral.StartsWith("✅") ? "background: #d4edda;" : "background: #f8d7da;")">
                    @mensajeGeneral
                </div>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <h4>📊 Cursos Registrados (@cursos?.Count)</h4>

            @if (cursos == null || cursos.Count == 0)
            {
                <div class="alert alert-info">No hay cursos registrados aún.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Código</th>
                                <th>Créditos</th>
                                <th>Activo</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var curso in cursos)
                            {
                                <tr>
                                    <td>@curso.Id</td>
                                    <td>@curso.Nombre</td>
                                    <td><strong>@curso.Codigo</strong></td>
                                    <td>@curso.Creditos</td>
                                    <td>@(curso.Activo ? "Sí" : "No")</td>
                                    <td>
                                        <button class="btn btn-sm btn-warning me-2" @onclick="() => CargarParaEditar(curso)">
                                            ✏️ Editar
                                        </button>
                                        <button class="btn btn-sm btn-danger" @onclick="() => ConfirmarEliminar(curso.Id)">
                                            🗑️ Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if (cursoEditando != null)
    {
        <div class="card mt-4 border-warning">
            <div class="card-body">
                <h4>✏️ Editar Curso</h4>
                <EditForm Model="cursoEditando" OnValidSubmit="GuardarCambios">
                    <DataAnnotationsValidator />
                    <ValidationSummary />

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="nombre-edit" class="form-label">Nombre:</label>
                            <InputText id="nombre-edit" class="form-control" @bind-Value="cursoEditando.Nombre" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="codigo-edit" class="form-label">Código:</label>
                            <InputText id="codigo-edit" class="form-control" @bind-Value="cursoEditando.Codigo" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="creditos-edit" class="form-label">Créditos:</label>
                            <InputNumber id="creditos-edit" class="form-control" @bind-Value="cursoEditando.Creditos" />
                        </div>
                        <div class="col-md-6 mb-3 form-check mt-4">
                            <InputCheckbox id="activo-edit" class="form-check-input" @bind-Value="cursoEditando.Activo" />
                            <label class="form-check-label" for="activo-edit">Activo</label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                    <button type="button" class="btn btn-secondary ms-2" @onclick="CancelarEdicion">Cancelar</button>
                </EditForm>
            </div>
        </div>
    }

    @if (mostrarConfirmacionEliminar)
    {
        <div class="card mt-4 border-danger">
            <div class="card-body">
                <div class="alert alert-danger" role="alert">
                    <h5>⚠️ Confirmar Eliminación</h5>
                    <p>¿Está seguro de que desea eliminar este curso?</p>
                    <p style="color: #721c24; font-size: 0.9em;"><strong>Esta acción no se puede deshacer.</strong></p>

                    <button class="btn btn-danger me-2" @onclick="EliminarCurso">Sí, Eliminar</button>
                    <button class="btn btn-secondary" @onclick="CancelarEliminar">Cancelar</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private ICollection<CursoDto> cursos = new List<CursoDto>();
    private string mensajeBusqueda = string.Empty;
    private string mensajeGeneral = string.Empty;
    private string codigoBusqueda = string.Empty;
    private CursoDto? cursoBuscado;

    private CursoFormDto nuevoCurso = new();
    private CursoFormDto? cursoEditando;
    private int idCursoEditando = 0;

    private bool mostrarConfirmacionEliminar = false;
    private int idCursoAEliminar = 0;

    protected override async Task OnInitializedAsync()
    {
        await CargarCursos();
    }

    private async Task CargarCursos()
    {
        cursos = await CursoService.GetAll();
    }

    private async Task BuscarPorCodigo()
    {
        mensajeBusqueda = string.Empty;
        cursoBuscado = null;

        if (string.IsNullOrWhiteSpace(codigoBusqueda))
        {
            mensajeBusqueda = "⚠️ Ingresa un código de curso para buscar.";
            return;
        }

        cursoBuscado = await CursoService.GetByCodigoAsync(codigoBusqueda.Trim());

        mensajeBusqueda = cursoBuscado == null
            ? "❌ No se encontró un curso con ese código."
            : "✅ Curso encontrado.";
    }

    private async Task RegistrarCurso()
    {
        if (string.IsNullOrWhiteSpace(nuevoCurso.Nombre) ||
            string.IsNullOrWhiteSpace(nuevoCurso.Codigo) ||
            nuevoCurso.Creditos <= 0)
        {
            mensajeGeneral = "⚠️ Completa todos los campos requeridos antes de continuar.";
            return;
        }

        var dto = new CursoDto
        {
            Nombre = nuevoCurso.Nombre,
            Codigo = nuevoCurso.Codigo,
            Creditos = nuevoCurso.Creditos,
            Activo = nuevoCurso.Activo
        };

        bool resultado = await CursoService.CreateAsync(dto);

        if (resultado)
        {
            mensajeGeneral = "✅ Curso creado exitosamente.";
            nuevoCurso = new CursoFormDto();
            await CargarCursos();
        }
        else
        {
            mensajeGeneral = "❌ Error al crear el curso. Verifica los datos e inténtalo de nuevo.";
        }
    }

    private void CargarParaEditar(CursoDto curso)
    {
        cursoEditando = new CursoFormDto
        {
            Id = curso.Id,
            Nombre = curso.Nombre,
            Codigo = curso.Codigo,
            Creditos = curso.Creditos,
            Activo = curso.Activo
        };
        idCursoEditando = curso.Id;
    }

    private async Task GuardarCambios()
    {
        if (cursoEditando == null)
            return;

        var dto = new CursoDto
        {
            Id = cursoEditando.Id ?? 0,
            Nombre = cursoEditando.Nombre,
            Codigo = cursoEditando.Codigo,
            Creditos = cursoEditando.Creditos,
            Activo = cursoEditando.Activo
        };

        bool resultado = await CursoService.UpdateAsync(idCursoEditando, dto);

        if (resultado)
        {
            mensajeGeneral = "✅ Curso actualizado exitosamente.";
            cursoEditando = null;
            idCursoEditando = 0;
            await CargarCursos();
        }
        else
        {
            mensajeGeneral = "❌ Error al actualizar el curso.";
        }
    }

    private void CancelarEdicion()
    {
        cursoEditando = null;
        idCursoEditando = 0;
    }

    private void ConfirmarEliminar(int id)
    {
        idCursoAEliminar = id;
        mostrarConfirmacionEliminar = true;
    }

    private async Task EliminarCurso()
    {
        bool resultado = await CursoService.DeleteAsync(idCursoAEliminar);

        if (resultado)
        {
            mensajeGeneral = "✅ Curso eliminado exitosamente.";
            mostrarConfirmacionEliminar = false;
            idCursoAEliminar = 0;
            await CargarCursos();
        }
        else
        {
            mensajeGeneral = "❌ Error al eliminar el curso.";
        }
    }

    private void CancelarEliminar()
    {
        mostrarConfirmacionEliminar = false;
        idCursoAEliminar = 0;
    }
}
